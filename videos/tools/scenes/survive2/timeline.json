{
 "dur": 70.99,
 "sentences": [
  {
   "i": 0,
   "t0": 0.0,
   "t1": 0.95,
   "text": "Три секунди."
  },
  {
   "i": 1,
   "t0": 1.27,
   "t1": 3.56,
   "text": "Саме стільки ти протримаєшся на Венері."
  },
  {
   "i": 2,
   "t0": 3.94,
   "t1": 5.25,
   "text": "А на інших планетах?"
  },
  {
   "i": 3,
   "t0": 5.92,
   "t1": 9.63,
   "text": "На Місяці спокійно: скафандр тримає, доки є кисень."
  },
  {
   "i": 4,
   "t0": 10.11,
   "t1": 11.5,
   "text": "Години вісім."
  },
  {
   "i": 5,
   "t0": 11.91,
   "t1": 15.6,
   "text": "На Меркурії ґрунт розжарений до чотирьохсот тридцяти градусів."
  },
  {
   "i": 6,
   "t0": 16.0,
   "t1": 18.95,
   "text": "Хвилин десять — і скафандр не впорається з жаром."
  },
  {
   "i": 7,
   "t0": 20.59,
   "t1": 23.56,
   "text": "На Венері тиск — як майже кілометр під водою."
  },
  {
   "i": 8,
   "t0": 23.92,
   "t1": 25.72,
   "text": "Скафандр сплющить за мить."
  },
  {
   "i": 9,
   "t0": 27.07,
   "t1": 31.13,
   "text": "На Марсі холодно й повітря майже немає, але скафандр тримає."
  },
  {
   "i": 10,
   "t0": 31.48,
   "t1": 32.41,
   "text": "Тут можна жити."
  },
  {
   "i": 11,
   "t0": 32.84,
   "t1": 36.36,
   "text": "На Юпітері стати ні на що — ти падаєш крізь хмари."
  },
  {
   "i": 12,
   "t0": 36.6,
   "t1": 40.15,
   "text": "Зонд «Галілео» протримався тут п'ятдесят вісім хвилин."
  },
  {
   "i": 13,
   "t0": 41.55,
   "t1": 43.79,
   "text": "А на Титані тиск майже як на Землі."
  },
  {
   "i": 14,
   "t0": 44.06,
   "t1": 46.13,
   "text": "Не вистачає лише тепла й кисню."
  },
  {
   "i": 15,
   "t0": 46.46,
   "t1": 48.76,
   "text": "А ще тут можна літати, як птах."
  },
  {
   "i": 16,
   "t0": 49.72,
   "t1": 53.88,
   "text": "На Нептуні мінус двісті й найшвидший вітер у Сонячній системі."
  },
  {
   "i": 17,
   "t0": 54.28,
   "t1": 55.11,
   "text": "Хвилин п'ять."
  },
  {
   "i": 18,
   "t0": 56.84,
   "t1": 58.65,
   "text": "А на Сонці — ні секунди."
  },
  {
   "i": 19,
   "t0": 61.42,
   "t1": 65.42,
   "text": "І лише на одній планеті можна жити без скафандра — на нашій."
  },
  {
   "i": 20,
   "t0": 66.21,
   "t1": 67.99,
   "text": "На якій планеті протримався б ти?"
  },
  {
   "i": 21,
   "t0": 68.46,
   "t1": 69.59,
   "text": "Пиши в коментарях."
  }
 ],
