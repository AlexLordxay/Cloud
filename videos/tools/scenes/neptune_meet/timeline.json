{
 "dur": 102.43,
 "phrases": [
  {
   "i": 0,
   "src": [
    0.0,
    2.74
   ],
   "t0": 0.25,
   "t1": 2.99,
   "text": "На Нептуні йдуть дощі з діамантів."
  },
  {
   "i": 1,
   "src": [
    3.05,
    4.57
   ],
   "t0": 3.3,
   "t1": 4.82,
   "text": "Стрибнемо — подивимось?"
  },
  {
   "i": 2,
   "src": [
    5.2,
    6.23
   ],
   "t0": 6.2,
   "t1": 7.23,
   "text": "Це Нептун —"
  },
  {
   "i": 3,
   "src": [
    6.61,
    11.34
   ],
   "t0": 7.61,
   "t1": 12.34,
   "text": "найдальша планета від Сонця. Він майже вчетверо ширший за Землю,"
  },
  {
   "i": 4,
   "src": [
    11.79,
    14.78
   ],
   "t0": 12.79,
   "t1": 15.78,
   "text": "а світло Сонця летить сюди чотири години."
  },
  {
   "i": 5,
   "src": [
    15.3,
    17.58
   ],
   "t0": 16.6,
   "t1": 18.88,
   "text": "І він не синій, як на старих фото,"
  },
  {
   "i": 6,
   "src": [
    17.9,
    19.2
   ],
   "t0": 19.2,
   "t1": 20.5,
   "text": "а блідо-блакитний."
  },
  {
   "i": 7,
   "src": [
    19.66,
    22.23
   ],
   "t0": 20.96,
   "t1": 23.53,
   "text": "Синім його колись зробили для контрасту."
  },
  {
   "i": 8,
   "src": [
    22.91,
    25.04
   ],
   "t0": 24.51,
   "t1": 26.64,
   "text": "Нептун спершу знайшли на папері:"
  },
  {
   "i": 9,
   "src": [
    25.58,
    29.91
   ],
   "t0": 27.18,
   "t1": 31.51,
   "text": "тисяча вісімсот сорок шостого року вчений вирахував, де він має бути,"
  },
  {
   "i": 10,
   "src": [
    30.38,
    32.07
   ],
   "t0": 31.98,
   "t1": 33.67,
   "text": "— і його побачили саме там."
  },
  {
   "i": 11,
   "src": [
    32.53,
    35.42
   ],
   "t0": 34.43,
   "t1": 37.32,
   "text": "Відтоді він облетів Сонце лише раз:"
  },
  {
   "i": 12,
   "src": [
    35.8,
    38.48
   ],
   "t0": 37.7,
   "t1": 40.38,
   "text": "рік тут — сто шістдесят п'ять наших."
  },
  {
   "i": 13,
   "src": [
    39.07,
    41.38
   ],
   "t0": 41.57,
   "t1": 43.88,
   "text": "Поверхні тут немає — лише хмари."
  },
  {
   "i": 14,
   "src": [
    41.77,
    43.89
   ],
   "t0": 44.27,
   "t1": 46.39,
   "text": "І падаєш ти майже як на Землі:"
  },
  {
   "i": 15,
   "src": [
    44.32,
    45.93
   ],
   "t0": 46.82,
   "t1": 48.43,
   "text": "тяжіння тут трохи більше."
  },
  {
   "i": 16,
   "src": [
    46.58,
    49.17
   ],
   "t0": 49.38,
   "t1": 51.97,
   "text": "Сонце звідси — просто яскрава зірка."
  },
  {
   "i": 17,
   "src": [
    49.52,
    52.67
   ],
   "t0": 52.32,
   "t1": 55.47,
   "text": "Але світить, як чотириста повних Місяців."
  },
  {
   "i": 18,
   "src": [
    53.31,
    55.86
   ],
   "t0": 56.41,
   "t1": 58.96,
   "text": "Тут найшвидший вітер у Сонячній системі —"
  },
  {
   "i": 19,
   "src": [
    56.21,
    58.31
   ],
   "t0": 59.31,
   "t1": 61.41,
   "text": "дві тисячі кілометрів на годину."
  },
  {
   "i": 20,
   "src": [
    58.65,
    62.03
   ],
   "t0": 61.75,
   "t1": 65.13,
   "text": "Він доніс би тебе з Києва до Львова за чверть години."
  },
  {
   "i": 21,
   "src": [
    62.63,
    64.44
   ],
   "t0": 66.03,
   "t1": 67.84,
   "text": "За бортом мінус двісті."
  },
  {
   "i": 22,
   "src": [
    64.88,
    68.21
   ],
   "t0": 68.28,
   "t1": 71.61,
   "text": "А нижчі хмари, ймовірно, пахнуть тухлими яйцями —"
  },
  {
   "i": 23,
   "src": [
    68.73,
    69.8
   ],
   "t0": 72.13,
   "t1": 73.2,
   "text": "це сірководень."
  },
  {
   "i": 24,
   "src": [
    70.3,
    74.28
   ],
   "t0": 74.0,
   "t1": 77.98,
   "text": "Що глибше — то темніше, гарячіше й тісніше."
  },
  {
   "i": 25,
   "src": [
    74.7,
    76.8
   ],
   "t0": 78.4,
   "t1": 80.5,
   "text": "Можливо, тут б'ють блискавки."
  },
  {
   "i": 26,
   "src": [
    77.29,
    81.93
   ],
   "t0": 82.19,
   "t1": 86.83,
   "text": "А на глибині тисяч кілометрів тиск стискає вуглець у кристали —"
  },
  {
   "i": 27,
   "src": [
    82.3,
    83.83
   ],
   "t0": 87.2,
   "t1": 88.73,
   "text": "і вони падають дощем."
  },
  {
   "i": 28,
   "src": [
    84.42,
    85.52
   ],
   "t0": 89.32,
   "t1": 90.42,
   "text": "Так вважають учені."
  },
  {
   "i": 29,
   "src": [
    85.95,
    87.72
   ],
   "t0": 91.35,
   "t1": 93.12,
   "text": "Дна ти не побачиш —"
  },
  {
   "i": 30,
   "src": [
    88.07,
    89.06
   ],
   "t0": 93.47,
   "t1": 94.46,
   "text": "його немає."
  },
  {
   "i": 31,
   "src": [
    89.73,
    91.58
   ],
   "t0": 95.53,
   "t1": 97.38,
   "text": "Яку планету показати наступною?"
  },
  {
   "i": 32,
   "src": [
    92.05,
    93.23
   ],
   "t0": 97.85,
   "t1": 99.03,
   "text": "Пиши в коментарях."
  }
 ],
