{
 "dur": 98.93,
 "phrases": [
  {
   "i": 0,
   "src": [
    107.36,
    109.54
   ],
   "t0": 0.25,
   "t1": 2.43,
   "text": "Її називають двійником Землі."
  },
  {
   "i": 1,
   "src": [
    3.67,
    5.73
   ],
   "t0": 2.88,
   "t1": 4.94,
   "text": "І вона зовсім не схожа на Землю."
  },
  {
   "i": 2,
   "src": [
    6.23,
    6.87
   ],
   "t0": 5.94,
   "t1": 6.58,
   "text": "Знайомся:"
  },
  {
   "i": 3,
   "src": [
    7.25,
    8.57
   ],
   "t0": 6.96,
   "t1": 8.28,
   "text": "Траппіст один е."
  },
  {
   "i": 4,
   "src": [
    9.02,
    11.13
   ],
   "t0": 8.28,
   "t1": 8.28,
   "text": "Її попросили показати в коментарях.",
   "skip": true
  },
  {
   "i": 5,
   "src": [
    11.51,
    13.99
   ],
   "t0": 8.73,
   "t1": 11.21,
   "text": "Вона за сорок світлових років від нас."
  },
  {
   "i": 6,
   "src": [
    14.37,
    15.9
   ],
   "t0": 11.59,
   "t1": 13.12,
   "text": "Розміром майже як Земля,"
  },
  {
   "i": 7,
   "src": [
    103.69,
    106.57
   ],
   "t0": 13.72,
   "t1": 16.6,
   "text": "і тепла́ отримує на третину менше, ніж ми."
  },
  {
   "i": 8,
   "src": [
    20.38,
    22.21
   ],
   "t0": 17.39,
   "t1": 19.22,
   "text": "Але її зоря — не Сонце,"
  },
  {
   "i": 9,
   "src": [
    22.53,
    25.94
   ],
   "t0": 19.54,
   "t1": 22.95,
   "text": "а тьмяний червоний карлик, ледь більший за Юпітер."
  },
  {
   "i": 10,
   "src": [
    26.34,
    30.04
   ],
   "t0": 23.85,
   "t1": 27.55,
   "text": "Планета так близько до зорі, що рік тут триває шість днів."
  },
  {
   "i": 11,
   "src": [
    30.55,
    31.91
   ],
   "t0": 28.06,
   "t1": 29.42,
   "text": "Тож якщо тобі тридцять —"
  },
  {
   "i": 12,
   "src": [
    32.22,
    34.63
   ],
   "t0": 29.73,
   "t1": 32.14,
   "text": "тут тобі було б майже тисяча вісімсот."
  },
  {
   "i": 13,
   "src": [
    97.64,
    101.79
   ],
   "t0": 33.09,
   "t1": 37.24,
   "text": "Найімові́рніше, вона завжди повернута до зорі одним боком."
  },
  {
   "i": 14,
   "src": [
    39.17,
    40.33
   ],
   "t0": 37.69,
   "t1": 38.85,
   "text": "Там вічний день:"
  },
  {
   "i": 15,
   "src": [
    40.84,
    42.87
   ],
   "t0": 39.36,
   "t1": 41.39,
   "text": "зоря нерухомо висить у небі."
  },
  {
   "i": 16,
   "src": [
    43.35,
    44.46
   ],
   "t0": 41.87,
   "t1": 42.98,
   "text": "А з другого боку —"
  },
  {
   "i": 17,
   "src": [
    44.73,
    45.63
   ],
   "t0": 43.25,
   "t1": 44.15,
   "text": "вічна ніч."
  },
  {
   "i": 18,
   "src": [
    46.05,
    47.69
   ],
   "t0": 45.07,
   "t1": 46.71,
   "text": "Поруч ще шість планет —"
  },
  {
   "i": 19,
   "src": [
    47.97,
    50.89
   ],
   "t0": 46.99,
   "t1": 49.91,
   "text": "і всі вони поміщаються всередині орбіти Меркурія."
  },
  {
   "i": 20,
   "src": [
    51.39,
    55.1
   ],
   "t0": 50.81,
   "t1": 54.52,
   "text": "Тому сусідні планети на небі бувають завбільшки як наш Місяць —"
  },
  {
   "i": 21,
   "src": [
    55.39,
    57.18
   ],
   "t0": 54.81,
   "t1": 56.6,
   "text": "і помітно пропливають повз."
  },
  {
   "i": 22,
   "src": [
    57.57,
    58.84
   ],
   "t0": 57.59,
   "t1": 58.86,
   "text": "Яка вона насправді,"
  },
  {
   "i": 23,
   "src": [
    59.15,
    60.24
   ],
   "t0": 59.17,
   "t1": 60.26,
   "text": "поки ніхто не знає."
  },
  {
   "i": 24,
   "src": [
    60.72,
    62.34
   ],
   "t0": 60.74,
   "t1": 62.36,
   "text": "Якщо там є повітря й вода,"
  },
  {
   "i": 25,
   "src": [
    62.6,
    64.7
   ],
   "t0": 62.62,
   "t1": 64.72,
   "text": "вчені припускають планету-око:"
  },
  {
   "i": 26,
   "src": [
    65.09,
    66.39
   ],
   "t0": 65.11,
   "t1": 66.41,
   "text": "усе вкрите кригою,"
  },
  {
   "i": 27,
   "src": [
    66.6,
    68.57
   ],
   "t0": 66.62,
   "t1": 68.59,
   "text": "а під зорею — відкритий океан."
  },
  {
   "i": 28,
   "src": [
    69.06,
    71.75
   ],
   "t0": 69.48,
   "t1": 72.17,
   "text": "І можливо, на його берегах є життя."
  },
  {
   "i": 29,
   "src": [
    72.16,
    75.64
   ],
   "t0": 73.18,
   "t1": 76.66,
   "text": "Тільки рослини під такою зорею, ймовірно, були б не зелені,"
  },
  {
   "i": 30,
   "src": [
    75.87,
    76.67
   ],
   "t0": 76.89,
   "t1": 77.69,
   "text": "а майже чорні —"
  },
  {
   "i": 31,
   "src": [
    77.16,
    79.28
   ],
   "t0": 78.18,
   "t1": 80.3,
   "text": "щоб ловити якомога більше світла."
  },
  {
   "i": 32,
   "src": [
    79.75,
    81.53
   ],
   "t0": 81.37,
   "t1": 83.15,
   "text": "Але поки це лише мрія."
  },
  {
   "i": 33,
   "src": [
    81.97,
    84.38
   ],
   "t0": 83.59,
   "t1": 86.0,
   "text": "Відповідь шукає телескоп «Джеймс Вебб» —"
  },
  {
   "i": 34,
   "src": [
    84.76,
    85.67
   ],
   "t0": 86.38,
   "t1": 87.29,
   "text": "просто зараз."
  },
  {
   "i": 35,
   "src": [
    86.01,
    88.92
   ],
   "t0": 88.13,
   "t1": 91.04,
   "text": "Надішли це тому, хто мріє про другу Землю."
  },
  {
   "i": 36,
   "src": [
    89.37,
    92.01
   ],
   "t0": 91.49,
   "t1": 94.13,
   "text": "І напиши, яку планету показати наступною."
  }
 ],
