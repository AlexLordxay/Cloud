{
 "dur": 101.46,
 "phrases": [
  {
   "i": 0,
   "src": [
    0.0,
    3.0
   ],
   "t0": 0.25,
   "t1": 3.25,
   "text": "Це найсхожіша на Землю планета, яку ми знаємо."
  },
  {
   "i": 1,
   "src": [
    3.67,
    5.73
   ],
   "t0": 3.92,
   "t1": 5.98,
   "text": "І вона зовсім не схожа на Землю."
  },
  {
   "i": 2,
   "src": [
    6.23,
    6.87
   ],
   "t0": 6.98,
   "t1": 7.62,
   "text": "Знайомся:"
  },
  {
   "i": 3,
   "src": [
    7.25,
    8.57
   ],
   "t0": 8.0,
   "t1": 9.32,
   "text": "Траппіст один е."
  },
  {
   "i": 4,
   "src": [
    9.02,
    11.13
   ],
   "t0": 9.77,
   "t1": 11.88,
   "text": "Її попросили показати в коментарях."
  },
  {
   "i": 5,
   "src": [
    11.51,
    13.99
   ],
   "t0": 12.26,
   "t1": 14.74,
   "text": "Вона за сорок світлових років від нас."
  },
  {
   "i": 6,
   "src": [
    14.37,
    15.9
   ],
   "t0": 15.12,
   "t1": 16.65,
   "text": "Розміром майже як Земля,"
  },
  {
   "i": 7,
   "src": [
    16.35,
    19.91
   ],
   "t0": 17.1,
   "t1": 20.66,
   "text": "кам'яна, і тепла отримує на третину менше, ніж ми."
  },
  {
   "i": 8,
   "src": [
    20.38,
    22.21
   ],
   "t0": 21.63,
   "t1": 23.46,
   "text": "Але її зоря — не Сонце,"
  },
  {
   "i": 9,
   "src": [
    22.53,
    25.94
   ],
   "t0": 23.78,
   "t1": 27.19,
   "text": "а тьмяний червоний карлик, ледь більший за Юпітер."
  },
  {
   "i": 10,
   "src": [
    26.34,
    30.04
   ],
   "t0": 28.09,
   "t1": 31.79,
   "text": "Планета так близько до зорі, що рік тут триває шість днів."
  },
  {
   "i": 11,
   "src": [
    30.55,
    31.91
   ],
   "t0": 32.3,
   "t1": 33.66,
   "text": "Тож якщо тобі тридцять —"
  },
  {
   "i": 12,
   "src": [
    32.22,
    34.63
   ],
   "t0": 33.97,
   "t1": 36.38,
   "text": "тут тобі було б майже тисяча вісімсот."
  },
  {
   "i": 13,
   "src": [
    35.04,
    38.65
   ],
   "t0": 37.29,
   "t1": 40.9,
   "text": "Найімовірніше, вона завжди повернута до зорі одним боком."
  },
  {
   "i": 14,
   "src": [
    39.17,
    40.33
   ],
   "t0": 41.42,
   "t1": 42.58,
   "text": "Там вічний день:"
  },
  {
   "i": 15,
   "src": [
    40.84,
    42.87
   ],
   "t0": 43.09,
   "t1": 45.12,
   "text": "зоря нерухомо висить у небі."
  },
  {
   "i": 16,
   "src": [
    43.35,
    44.46
   ],
   "t0": 45.6,
   "t1": 46.71,
   "text": "А з другого боку —"
  },
  {
   "i": 17,
   "src": [
    44.73,
    45.63
   ],
   "t0": 46.98,
   "t1": 47.88,
   "text": "вічна ніч."
  },
  {
   "i": 18,
   "src": [
    46.05,
    47.69
   ],
   "t0": 48.8,
   "t1": 50.44,
   "text": "Поруч ще шість планет —"
  },
  {
   "i": 19,
   "src": [
    47.97,
    50.89
   ],
   "t0": 50.72,
   "t1": 53.64,
   "text": "і всі вони поміщаються всередині орбіти Меркурія."
  },
  {
   "i": 20,
   "src": [
    51.39,
    55.1
   ],
   "t0": 54.54,
   "t1": 58.25,
   "text": "Тому сусідні планети на небі бувають завбільшки як наш Місяць —"
  },
  {
   "i": 21,
   "src": [
    55.39,
    57.18
   ],
   "t0": 58.54,
   "t1": 60.33,
   "text": "і помітно пропливають повз."
  },
  {
   "i": 22,
   "src": [
    57.57,
    58.84
   ],
   "t0": 61.32,
   "t1": 62.59,
   "text": "Яка вона насправді,"
  },
  {
   "i": 23,
   "src": [
    59.15,
    60.24
   ],
   "t0": 62.9,
   "t1": 63.99,
   "text": "поки ніхто не знає."
  },
  {
   "i": 24,
   "src": [
    60.72,
    62.34
   ],
   "t0": 64.47,
   "t1": 66.09,
   "text": "Якщо там є повітря й вода,"
  },
  {
   "i": 25,
   "src": [
    62.6,
    64.7
   ],
   "t0": 66.35,
   "t1": 68.45,
   "text": "вчені припускають планету-око:"
  },
  {
   "i": 26,
   "src": [
    65.09,
    66.39
   ],
   "t0": 68.84,
   "t1": 70.14,
   "text": "усе вкрите кригою,"
  },
  {
   "i": 27,
   "src": [
    66.6,
    68.57
   ],
   "t0": 70.35,
   "t1": 72.32,
   "text": "а під зорею — відкритий океан."
  },
  {
   "i": 28,
   "src": [
    69.06,
    71.75
   ],
   "t0": 73.21,
   "t1": 75.9,
   "text": "І можливо, на його берегах є життя."
  },
  {
   "i": 29,
   "src": [
    72.16,
    75.64
   ],
   "t0": 76.91,
   "t1": 80.39,
   "text": "Тільки рослини під такою зорею, ймовірно, були б не зелені,"
  },
  {
   "i": 30,
   "src": [
    75.87,
    76.67
   ],
   "t0": 80.62,
   "t1": 81.42,
   "text": "а майже чорні —"
  },
  {
   "i": 31,
   "src": [
    77.16,
    79.28
   ],
   "t0": 81.91,
   "t1": 84.03,
   "text": "щоб ловити якомога більше світла."
  },
  {
   "i": 32,
   "src": [
    79.75,
    81.53
   ],
   "t0": 85.1,
   "t1": 86.88,
   "text": "Але поки це лише мрія."
  },
  {
   "i": 33,
   "src": [
    81.97,
    84.38
   ],
   "t0": 87.32,
   "t1": 89.73,
   "text": "Відповідь шукає телескоп «Джеймс Вебб» —"
  },
  {
   "i": 34,
   "src": [
    84.76,
    85.67
   ],
   "t0": 90.11,
   "t1": 91.02,
   "text": "просто зараз."
  },
  {
   "i": 35,
   "src": [
    86.01,
    88.92
   ],
   "t0": 91.86,
   "t1": 94.77,
   "text": "Надішли це тому, хто мріє про другу Землю."
  },
  {
   "i": 36,
   "src": [
    89.37,
    92.01
   ],
   "t0": 95.22,
   "t1": 97.86,
   "text": "І напиши, яку планету показати наступною."
  }
 ],
