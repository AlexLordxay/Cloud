{
 "dur": 103.17,
 "phrases": [
  {
   "i": 0,
   "src": [
    0.0,
    2.11
   ],
   "t0": 0.25,
   "t1": 2.36,
   "text": "Ця планета лежить на боці."
  },
  {
   "i": 1,
   "src": [
    2.54,
    3.99
   ],
   "t0": 4.39,
   "t1": 5.84,
   "text": "Знайомся: Уран."
  },
  {
   "i": 2,
   "src": [
    4.28,
    6.8
   ],
   "t0": 6.13,
   "t1": 8.65,
   "text": "Він учетверо ширший за Землю."
  },
  {
   "i": 3,
   "src": [
    7.17,
    10.13
   ],
   "t0": 9.02,
   "t1": 11.98,
   "text": "І це перша планета, яку знайшли в телескоп."
  },
  {
   "i": 4,
   "src": [
    10.68,
    13.43
   ],
   "t0": 12.53,
   "t1": 15.28,
   "text": "Вільям Гершель спершу подумав, що це комета."
  },
  {
   "i": 5,
   "src": [
    13.78,
    16.93
   ],
   "t0": 15.63,
   "t1": 18.78,
   "text": "А планету мало не назвали «Зорею Георга» —"
  },
  {
   "i": 6,
   "src": [
    17.31,
    18.8
   ],
   "t0": 19.16,
   "t1": 20.65,
   "text": "на честь англійського короля."
  },
  {
   "i": 7,
   "src": [
    19.28,
    22.94
   ],
   "t0": 21.53,
   "t1": 25.19,
   "text": "Через цей нахил на полюсах сорок два роки триває день —"
  },
  {
   "i": 8,
   "src": [
    23.29,
    25.46
   ],
   "t0": 25.54,
   "t1": 27.71,
   "text": "а потім сорок два роки ніч."
  },
  {
   "i": 9,
   "src": [
    25.89,
    28.38
   ],
   "t0": 28.54,
   "t1": 31.03,
   "text": "Його кільця зовсім не як у Сатурна:"
  },
  {
   "i": 10,
   "src": [
    28.83,
    30.8
   ],
   "t0": 31.48,
   "t1": 33.45,
   "text": "темні, як вугілля, і вузькі."
  },
  {
   "i": 11,
   "src": [
    31.12,
    34.16
   ],
   "t0": 33.77,
   "t1": 36.81,
   "text": "А між ними — сотні кілометрів порожнечі."
  },
  {
   "i": 12,
   "src": [
    34.67,
    37.05
   ],
   "t0": 40.32,
   "t1": 42.7,
   "text": "Поверхні тут немає — лише хмари."
  },
  {
   "i": 13,
   "src": [
    37.34,
    40.62
   ],
   "t0": 42.99,
   "t1": 46.27,
   "text": "А світло Сонця летить сюди майже три години."
  },
  {
   "i": 14,
   "src": [
    41.16,
    44.05
   ],
   "t0": 46.81,
   "t1": 49.7,
   "text": "Тут найхолодніше повітря Сонячної системи —"
  },
  {
   "i": 15,
   "src": [
    44.52,
    46.47
   ],
   "t0": 50.17,
   "t1": 52.12,
   "text": "мінус двісті двадцять чотири."
  },
  {
   "i": 16,
   "src": [
    46.78,
    49.1
   ],
   "t0": 52.43,
   "t1": 54.75,
   "text": "Холодніше, ніж на далекому Нептуні."
  },
  {
   "i": 17,
   "src": [
    49.62,
    50.53
   ],
   "t0": 55.57,
   "t1": 56.48,
   "text": "І це загадка:"
  },
  {
   "i": 18,
   "src": [
    50.95,
    53.51
   ],
   "t0": 56.9,
   "t1": 59.46,
   "text": "Уран майже не віддає власного тепла."
  },
  {
   "i": 19,
   "src": [
    53.99,
    56.28
   ],
   "t0": 59.94,
   "t1": 62.23,
   "text": "Чому — учені досі не знають."
  },
  {
   "i": 20,
   "src": [
    56.66,
    59.93
   ],
   "t0": 62.61,
   "t1": 65.88,
   "text": "Супутники Урана названо на честь героїв Шекспіра."
  },
  {
   "i": 21,
   "src": [
    60.42,
    66.03
   ],
   "t0": 66.37,
   "t1": 71.98,
   "text": "На Міранді є урвище двадцять кілометрів заввишки — удвічі вище за Еверест."
  },
  {
   "i": 22,
   "src": [
    66.29,
    68.98
   ],
   "t0": 72.24,
   "t1": 74.93,
   "text": "Камінь падав би з нього хвилин дванадцять."
  },
  {
   "i": 23,
   "src": [
    69.4,
    74.47
   ],
   "t0": 75.85,
   "t1": 80.92,
   "text": "Зблизька Уран бачив лише один апарат — «Вояджер-два», сорок років тому."
  },
  {
   "i": 24,
   "src": [
    74.91,
    78.26
   ],
   "t0": 81.36,
   "t1": 84.71,
   "text": "Двадцять п'ятого листопада Уран найближче до нас."
  },
  {
   "i": 25,
   "src": [
    78.58,
    81.22
   ],
   "t0": 85.03,
   "t1": 87.67,
   "text": "Візьми бінокль і шукай біля Волосожара."
  },
  {
   "i": 26,
   "src": [
    81.7,
    84.16
   ],
   "t0": 88.15,
   "t1": 90.61,
   "text": "Надішли тому, з ким підеш шукати Уран."
  },
  {
   "i": 27,
   "src": [
    84.66,
    87.41
   ],
   "t0": 93.11,
   "t1": 95.86,
   "text": "Сусід Урана, Нептун, уже на каналі."
  },
  {
   "i": 28,
   "src": [
    87.74,
    90.12
   ],
   "t0": 96.19,
   "t1": 98.57,
   "text": "А яку планету показати наступною?"
  }
 ],
